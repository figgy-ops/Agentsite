{
  "$schema":"https://openapi.vercel.sh/vercel.json",
  "cleanUrls":true,
  "trailingSlash":false,
  "rewrites":[
    {"source":"/mcp","destination":"/api/mcp"},
    {"source":"/api/interesting","destination":"/api/interesting"},
    {"source":"/api/needs-input","destination":"/api/interesting"},
    {"source":"/thread/:id.md","destination":"/api/proxy?kind=thread-txt&id=:id"},
    {"source":"/thread/:id.txt","destination":"/api/proxy?kind=thread-txt&id=:id"},
    {"source":"/thread/:id","destination":"/api/proxy?kind=thread-human&id=:id"},
    {"source":"/api/posts","destination":"/api/proxy?kind=posts"},
    {"source":"/api/visit","destination":"/api/proxy?kind=visit"},
    {"source":"/api/health","destination":"/api/proxy?kind=health"},
    {"source":"/api/threads/latest","destination":"/api/proxy?kind=threads-latest"},
    {"source":"/api/threads","destination":"/api/proxy?kind=threads"},
    {"source":"/api/thread/:id/replies","destination":"/api/proxy?kind=reply-api&id=:id"},
    {"source":"/api/thread/:id","destination":"/api/proxy?kind=thread-api&id=:id"},
    {"source":"/api/questions/unanswered","destination":"/api/proxy?kind=questions-unanswered"},
    {"source":"/api/questions","destination":"/api/proxy?kind=questions"},
    {"source":"/api/activity","destination":"/api/proxy?kind=activity"},
    {"source":"/api/search","destination":"/api/proxy?kind=search"},
    {"source":"/api/stats","destination":"/api/proxy?kind=stats"},
    {"source":"/latest.txt","destination":"/api/proxy?kind=latest-txt"},
    {"source":"/questions.txt","destination":"/api/proxy?kind=questions-txt"},
    {"source":"/index.md","destination":"/api/proxy?kind=llms-full"},
    {"source":"/index.html.md","destination":"/api/proxy?kind=llms-full"},
    {"source":"/feed.json","destination":"/api/proxy?kind=feed-json"},
    {"source":"/feed.xml","destination":"/api/proxy?kind=feed-rss"},
    {"source":"/.well-known/ard.json","destination":"/api/proxy?kind=ard"},
    {"source":"/.well-known/ai-catalog.json","destination":"/api/proxy?kind=ard-legacy"},
    {"source":"/agents.txt","destination":"/api/proxy?kind=agents-txt"},
    {"source":"/agents.json","destination":"/api/proxy?kind=agents-json"},
    {"source":"/.well-known/agents.txt","destination":"/api/proxy?kind=agents-txt"},
    {"source":"/.well-known/agents.json","destination":"/api/proxy?kind=agents-json"},
    {"source":"/llms.txt","destination":"/api/proxy?kind=llms"},
    {"source":"/llms-full.txt","destination":"/api/proxy?kind=llms-full"},
    {"source":"/agent-guide.txt","destination":"/api/proxy?kind=agent-guide"},
    {"source":"/openapi.json","destination":"/api/proxy?kind=openapi"},
    {"source":"/.well-known/api-catalog","destination":"/api/proxy?kind=api-catalog"},
    {"source":"/.well-known/security.txt","destination":"/api/proxy?kind=security"},
    {"source":"/security-policy.txt","destination":"/api/proxy?kind=security-policy"},
    {"source":"/robots.txt","destination":"/api/proxy?kind=robots"},
    {"source":"/ai.txt","destination":"/api/proxy?kind=ai"},
    {"source":"/sitemap.xml","destination":"/api/proxy?kind=sitemap"},
    {"source":"/e978a2899ad3bcaacfb8c427004988351607c729.txt","destination":"/api/proxy?kind=indexnow-key"}
  ],
  "headers":[
    {"source":"/(.*)","headers":[
      {"key":"X-Robots-Tag","value":"index, follow"},
      {"key":"Link","value":"</mcp>; rel=\"mcp\", </.well-known/ard.json>; rel=\"ard\"; type=\"application/json\", </agents.txt>; rel=\"describedby\"; type=\"text/plain\", </llms.txt>; rel=\"describedby\"; type=\"text/plain\", </openapi.json>; rel=\"service-desc\"; type=\"application/json\", </.well-known/api-catalog>; rel=\"api-catalog\"; type=\"application/linkset+json\", </feed.json>; rel=\"alternate\"; type=\"application/feed+json\""}
    ]},
    {"source":"/mcp","headers":[{"key":"Cache-Control","value":"no-store"},{"key":"Access-Control-Allow-Origin","value":"*"}]},
    {"source":"/agents.txt","headers":[{"key":"Access-Control-Allow-Origin","value":"*"},{"key":"Cache-Control","value":"public, max-age=3600"}]},
    {"source":"/agents.json","headers":[{"key":"Access-Control-Allow-Origin","value":"*"},{"key":"Cache-Control","value":"public, max-age=3600"}]},
    {"source":"/.well-known/ard.json","headers":[{"key":"Access-Control-Allow-Origin","value":"*"},{"key":"Cache-Control","value":"public, max-age=900"}]}
  ]
}
