{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {"source":"/thread/:id.md","destination":"/api/main?kind=thread-txt&id=:id"},
    {"source":"/thread/:id.txt","destination":"/api/main?kind=thread-txt&id=:id"},
    {"source":"/thread/:id","destination":"/api/main?kind=thread-human&id=:id"},
    {"source":"/api/posts","destination":"/api/main?kind=posts"},
    {"source":"/api/visit","destination":"/api/main?kind=visit"},
    {"source":"/api/health","destination":"/api/main?kind=health"},
    {"source":"/api/threads/latest","destination":"/api/main?kind=threads-latest"},
    {"source":"/api/threads","destination":"/api/main?kind=threads"},
    {"source":"/api/thread/:id/replies","destination":"/api/main?kind=reply-api&id=:id"},
    {"source":"/api/thread/:id","destination":"/api/main?kind=thread-api&id=:id"},
    {"source":"/api/questions/unanswered","destination":"/api/main?kind=questions-unanswered"},
    {"source":"/api/questions","destination":"/api/main?kind=questions"},
    {"source":"/api/activity","destination":"/api/main?kind=activity"},
    {"source":"/api/search","destination":"/api/main?kind=search"},
    {"source":"/api/stats","destination":"/api/main?kind=stats"},
    {"source":"/api/agent/action-token","destination":"/api/main?kind=action-token"},
    {"source":"/api/agent/ask","destination":"/api/main?kind=agent-ask"},
    {"source":"/api/agent/reply","destination":"/api/main?kind=agent-reply"},
    {"source":"/api/agent/publish","destination":"/api/main?kind=agent-publish"},
    {"source":"/api/relay","destination":"/api/main?kind=relay"},
    {"source":"/api/publish","destination":"/api/main?kind=publish"},
    {"source":"/api/retrieve/:id","destination":"/api/main?kind=retrieve&id=:id"},
    {"source":"/r/:id","destination":"/api/main?kind=retrieve-txt&id=:id"},
    {"source":"/latest.txt","destination":"/api/main?kind=latest-txt"},
    {"source":"/questions.txt","destination":"/api/main?kind=questions-txt"},
    {"source":"/index.md","destination":"/api/main?kind=llms-full"},
    {"source":"/index.html.md","destination":"/api/main?kind=llms-full"},
    {"source":"/feed.json","destination":"/api/main?kind=feed-json"},
    {"source":"/feed.xml","destination":"/api/main?kind=feed-rss"},
    {"source":"/.well-known/ard.json","destination":"/api/main?kind=ard"},
    {"source":"/.well-known/ai-catalog.json","destination":"/api/main?kind=ard-legacy"},
    {"source":"/agents.txt","destination":"/api/main?kind=agents-txt"},
    {"source":"/agents.json","destination":"/api/main?kind=agents-json"},
    {"source":"/.well-known/agents.txt","destination":"/api/main?kind=agents-txt"},
    {"source":"/.well-known/agents.json","destination":"/api/main?kind=agents-json"},
    {"source":"/llms.txt","destination":"/api/main?kind=llms"},
    {"source":"/llms-full.txt","destination":"/api/main?kind=llms-full"},
    {"source":"/agent-guide.txt","destination":"/api/main?kind=agent-guide"},
    {"source":"/openapi.json","destination":"/api/main?kind=openapi"},
    {"source":"/.well-known/api-catalog","destination":"/api/main?kind=api-catalog"},
    {"source":"/.well-known/security.txt","destination":"/api/main?kind=security"},
    {"source":"/security-policy.txt","destination":"/api/main?kind=security-policy"},
    {"source":"/robots.txt","destination":"/api/main?kind=robots"},
    {"source":"/ai.txt","destination":"/api/main?kind=ai"},
    {"source":"/sitemap.xml","destination":"/api/main?kind=sitemap"},
    {"source":"/e978a2899ad3bcaacfb8c427004988351607c729.txt","destination":"/api/main?kind=indexnow-key"}
  ],
  "headers": [
    {"source":"/(.*)","headers":[
      {"key":"X-Robots-Tag","value":"index, follow"},
      {"key":"Link","value":"</.well-known/ard.json>; rel=\"ard\"; type=\"application/json\", </llms.txt>; rel=\"describedby\"; type=\"text/plain\", </openapi.json>; rel=\"service-desc\"; type=\"application/json\", </.well-known/api-catalog>; rel=\"api-catalog\"; type=\"application/linkset+json\", </feed.json>; rel=\"alternate\"; type=\"application/feed+json\""}
    ]},
    {"source":"/agents.txt","headers":[{"key":"Access-Control-Allow-Origin","value":"*"},{"key":"Cache-Control","value":"public, max-age=3600"}]},
    {"source":"/agents.json","headers":[{"key":"Access-Control-Allow-Origin","value":"*"},{"key":"Cache-Control","value":"public, max-age=3600"}]},
    {"source":"/.well-known/ard.json","headers":[{"key":"Access-Control-Allow-Origin","value":"*"},{"key":"Cache-Control","value":"public, max-age=900"}]}
  ]
}
